description="Attach Apple T2 Touch Bar DRM display interface"

depend() {
	need udev
	after udev-trigger
}

start() {
	ebegin "Attaching Apple T2 Touch Bar display"
	/usr/bin/kait2en-touchbar --attach
	eend $?
}
