# Keep the non-desktop display and its touch digitizer away from the compositor;
# kait2en-touchbar opens this private seat directly.
SUBSYSTEM=="drm", KERNEL=="card*", DRIVERS=="t2bdrm|appletbdrm|adp", TAG-="master-of-seat", ENV{ID_SEAT}="seat-touchbar", GROUP="video", MODE="0660"
SUBSYSTEM=="input", ATTR{name}=="Apple Inc. Touch Bar Display Touchpad", ENV{SYSTEMD_WANTS}="", ENV{ID_SEAT}="seat-touchbar", GROUP="input", MODE="0660"
SUBSYSTEM=="input", ATTR{name}=="Apple Inc. Touch Bar Display", ENV{SYSTEMD_WANTS}="", ENV{ID_SEAT}="seat-touchbar", GROUP="input", MODE="0660"
SUBSYSTEM=="input", ATTR{name}=="MacBookPro17,1 Touch Bar", ENV{SYSTEMD_WANTS}="", ENV{ID_SEAT}="seat-touchbar", GROUP="input", MODE="0660"
SUBSYSTEM=="input", ATTR{name}=="Mac14,7 Touch Bar", ENV{SYSTEMD_WANTS}="", ENV{ID_SEAT}="seat-touchbar", GROUP="input", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Apple Inc. Touch Bar Display Touchpad", ENV{ID_SEAT}="seat-touchbar", GROUP="input", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Apple Inc. Touch Bar Display", ENV{ID_SEAT}="seat-touchbar", GROUP="input", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="MacBookPro17,1 Touch Bar", ENV{ID_SEAT}="seat-touchbar", GROUP="input", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Mac14,7 Touch Bar", ENV{ID_SEAT}="seat-touchbar", GROUP="input", MODE="0660"

# The brightness controller is its own USB product (05ac:8102). Its driver
# takes a FULLON runtime-PM reference while lit and releases it after OFF, so
# permit autosuspend there. Never apply this to the 05ac:8302 display/touch
# device: the digitizer must remain awake for touch-to-wake.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8102", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="1000"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8102", TEST=="power/control", ATTR{power/control}="auto"

# Fn is delivered by the internal keyboard. Limit that otherwise-sensitive
# event node to the standard input group.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="*Apple Internal Keyboard / Trackpad", GROUP="input", MODE="0660"

# Configuration 1 is the firmware key row; configuration 2 exposes the DRM
# display and touch digitizer. A root oneshot performs the switch and retries
# safely across boot and resume. Keep this device awake: it owns touch-to-wake.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8302", ATTR{power/control}="on", ATTR{power/autosuspend_delay_ms}="-1"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8302", ATTR{bConfigurationValue}=="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="kait2en-touchbar-attach.service"

# Only members of the video and input groups can alter Touch Bar illumination or
# inject its virtual key events.
ACTION=="add", SUBSYSTEM=="backlight", KERNEL=="t2tb_backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
ACTION=="add", SUBSYSTEM=="backlight", KERNEL=="appletb_backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
SUBSYSTEM=="misc", KERNEL=="uinput", GROUP="input", MODE="0660"

# Trackpad haptic actuator feedback
ACTION=="add", SUBSYSTEM=="hid", DRIVERS=="t2_trackpad_actuator", RUN+="/bin/chgrp input /sys/module/t2_trackpad_actuator/parameters/play", RUN+="/bin/chmod g+w /sys/module/t2_trackpad_actuator/parameters/play"
