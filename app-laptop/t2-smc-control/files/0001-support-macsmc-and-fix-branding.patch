 fn read_battery_overview(hwmon: &Path) -> BatteryOverview {
+    let capacity = read_i64(&hwmon.join("smc_battery_capacity_percent"))
+        .and_then(|value| u8::try_from(value.clamp(0, 100)).ok());
+    if capacity.is_some() {
+        return BatteryOverview {
+            capacity_percent: capacity,
+            current_ua: read_i64(&hwmon.join("smc_battery_current_ua")),
+            charge_now_uah: read_i64(&hwmon.join("smc_battery_charge_now_uah")),
+            charge_full_uah: read_i64(&hwmon.join("smc_battery_charge_full_uah")),
+            adapter_power_uw: read_i64(&hwmon.join("smc_adapter_power_uw")),
+        };
+    }
+
+    // Fallback for macsmc / standard Linux power_supply
+    let bat_dir = ["/sys/class/power_supply/macsmc-battery", "/sys/class/power_supply/BAT0"]
+        .into_iter()
+        .map(Path::new)
+        .find(|p| p.exists());
+    let ac_dir = ["/sys/class/power_supply/macsmc-ac", "/sys/class/power_supply/AC"]
+        .into_iter()
+        .map(Path::new)
+        .find(|p| p.exists());
+
+    let capacity_percent = bat_dir.and_then(|b| read_i64(&b.join("capacity")))
+        .and_then(|value| u8::try_from(value.clamp(0, 100)).ok());
+    let mut current_ua = bat_dir.and_then(|b| read_i64(&b.join("current_now")));
+    let status = bat_dir.and_then(|b| fs::read_to_string(b.join("status")).ok()).map(|s| s.trim().to_lowercase());
+    if let (Some(c), Some(ref s)) = (current_ua, status) {
+        if s == "discharging" && c > 0 {
+            current_ua = Some(-c);
+        }
+    }
+    let charge_now_uah = bat_dir.and_then(|b| read_i64(&b.join("charge_now")));
+    let charge_full_uah = bat_dir.and_then(|b| read_i64(&b.join("charge_full")));
+    let adapter_power_uw = ac_dir.and_then(|a| {
+        let online = read_i64(&a.join("online")).unwrap_or(0);
+        if online == 1 {
+            if let Some(p) = read_i64(&a.join("power_now")) {
+                Some(p)
+            } else {
+                let v = read_i64(&a.join("voltage_now")).unwrap_or(0);
+                let c = read_i64(&a.join("current_now")).unwrap_or(0);
+                if v > 0 && c > 0 {
+                    Some((v as i128 * c as i128 / 1_000_000) as i64)
+                } else {
+                    read_i64(&hwmon.join("power1_input"))
+                }
+            }
+        } else {
+            Some(0)
+        }
+    });
+
