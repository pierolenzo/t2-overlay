+fn extract_smc_key(raw: &str) -> String {
+    let raw = raw.trim();
+    if let Some(start) = raw.rfind('(') {
+        if let Some(end) = raw[start..].find(')') {
+            let candidate = raw[start + 1..start + end].trim();
+            if candidate.len() == 4 {
+                return candidate.to_string();
+            }
+        }
+    }
+    raw.to_string()
