diff --git a/build.rs b/build.rs
new file mode 100644
index 0000000..596446a
--- /dev/null
+++ b/build.rs
@@ -0,0 +1,37 @@
+use std::process::Command;
+
+fn main() {
+    println!("cargo:rustc-link-lib=wayland-client");
+    let out_dir = std::env::var("OUT_DIR").unwrap();
+    let manifest_dir = std::env::var("CARGO_MANIFEST_DIR").unwrap();
+
+    let c1 = format!("{manifest_dir}/src/wlr-gamma-client-protocol.c");
+    let c2 = format!("{manifest_dir}/src/wlr_gamma.c");
+    let o1 = format!("{out_dir}/wlr-gamma-client-protocol.o");
+    let o2 = format!("{out_dir}/wlr_gamma.o");
+    let lib = format!("{out_dir}/libwlr_gamma.a");
+
+    let cc = std::env::var("CC").unwrap_or_else(|_| "cc".into());
+    let ar = std::env::var("AR").unwrap_or_else(|_| "ar".into());
+
+    let status1 = Command::new(&cc)
+        .args(["-c", "-fPIC", "-O2", &format!("-I{manifest_dir}/src"), &c1, "-o", &o1])
+        .status()
+        .expect("cc failed compiling protocol");
+    let status2 = Command::new(&cc)
+        .args(["-c", "-fPIC", "-O2", &format!("-I{manifest_dir}/src"), &c2, "-o", &o2])
+        .status()
+        .expect("cc failed compiling wlr_gamma");
+    assert!(status1.success() && status2.success());
+
+    let status_ar = Command::new(&ar)
+        .args(["crus", &lib, &o1, &o2])
+        .status()
+        .expect("ar failed creating static library");
+    assert!(status_ar.success());
+
+    println!("cargo:rustc-link-search=native={out_dir}");
+    println!("cargo:rustc-link-lib=static=wlr_gamma");
+    println!("cargo:rerun-if-changed=src/wlr_gamma.c");
+    println!("cargo:rerun-if-changed=src/wlr-gamma-client-protocol.c");
+}
