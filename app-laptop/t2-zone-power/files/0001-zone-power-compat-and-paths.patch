diff -uprN a/src/plimit.rs b/src/plimit.rs
--- a/src/plimit.rs	2026-11-11 03:30:45.252633854 +0100
+++ b/src/plimit.rs	2026-11-12 17:05:28.899931951 +0100
@@ -34,6 +34,9 @@ impl PLimits {
     /// Parses `smc_plimit_raw`, for example `2e001627 0f`
     pub fn read(t2smc: &Path) -> Result<Self> {
         let path = t2smc.join("smc_plimit_raw");
+        if !path.exists() {
+            return Ok(Self::default());
+        }
