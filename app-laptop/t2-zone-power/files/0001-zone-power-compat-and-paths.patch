diff -uprN a/src/sensors.rs b/src/sensors.rs
--- a/src/sensors.rs	2026-10-15 19:01:13.253932506 +0200
+++ b/src/sensors.rs	2026-11-12 17:05:28.899858987 +0100
@@ -25,7 +25,16 @@ impl SmcSensors {
         for label in glob_paths(&format!("{}/*_label", t2smc.display())).unwrap_or_default() {
             let (Ok(key), Some(name)) = (read_string(&label), label.file_name()) else { continue };
             let input = name.to_string_lossy().replace("_label", "_input");
-            inputs.insert(key, t2smc.join(input));
+            let raw_key = key.clone();
+            if let Some(start) = raw_key.rfind('(') {
+                if let Some(end) = raw_key.rfind(')') {
+                    if start < end {
+                        let extracted = raw_key[start + 1..end].trim();
+                        inputs.insert(extracted.to_string(), t2smc.join(&input));
+                    }
+                }
+            }
+            inputs.insert(raw_key, t2smc.join(input));
         }
         Self { t2smc: t2smc.to_owned(), inputs, dgpu: OnceCell::new() }
     }
