# Helper tool to manage complementary Touch ID authentication (pam_fprintd) in PAM on Gentoo

set -euo pipefail

PAM_FPRINT="auth        sufficient    pam_fprintd.so"

check_root() {
	if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
		echo "Error: This tool requires root privileges." >&2
		exit 1
	fi
}

status_file() {
	local target="$1"
	local file="/etc/pam.d/${target}"
	if [[ ! -f "$file" ]]; then
		echo "[-] /etc/pam.d/${target}: file does not exist"
		return 1
	fi
	if grep -qE "^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_fprintd\.so" "$file"; then
		echo "[+] /etc/pam.d/${target}: Touch ID enabled (complementary with password fallback)"
		return 0
	else
		echo "[-] /etc/pam.d/${target}: Touch ID not enabled"
		return 1
	fi
}

enable_file() {
	local target="$1"
	local file="/etc/pam.d/${target}"
	check_root

	if [[ ! -f "$file" ]]; then
		echo "Error: ${file} not found." >&2
		return 1
	fi

	if grep -qE "^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_fprintd\.so" "$file"; then
		echo "[=] Touch ID is already enabled in ${file}"
		return 0
	fi

	# Create a backup
	cp -a "$file" "${file}.bak.$(date +%Y%m%d%H%M%S)"

	# Insert pam_fprintd right before the first auth line or system-auth inclusion
	if grep -qn "^auth" "$file"; then
		local first_auth_line
		first_auth_line=$(grep -n "^auth" "$file" | head -n1 | cut -d: -f1)
		sed -i "${first_auth_line}i ${PAM_FPRINT}" "$file"
	else
		echo -e "\n${PAM_FPRINT}" >> "$file"
	fi

	echo "[+] Successfully enabled complementary Touch ID in ${file}"
}

disable_file() {
	local target="$1"
	local file="/etc/pam.d/${target}"
	check_root

	if [[ ! -f "$file" ]]; then
		echo "Error: ${file} not found." >&2
		return 1
	fi

	if ! grep -qE "^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_fprintd\.so" "$file"; then
		echo "[-] Touch ID is not configured in ${file}"
		return 0
	fi

	sed -i "/^[[:space:]]*auth[[:space:]]\+sufficient[[:space:]]\+pam_fprintd\.so/d" "$file"
	echo "[-] Successfully removed Touch ID from ${file}"
}

ACTION="${1:---status}"
TARGET="${2:-sudo}"

case "$TARGET" in
	sudo)
		TARGETS=("sudo")
		;;
	login)
		TARGETS=("login" "system-auth")
		;;
	all)
		TARGETS=("sudo" "login" "system-auth" "sddm" "gdm")
		;;
	*)
		TARGETS=("$TARGET")
		;;
esac

case "$ACTION" in
	--status|-s|status)
		for t in "${TARGETS[@]}"; do
			if [[ -f "/etc/pam.d/${t}" ]]; then
				status_file "$t" || true
			fi
		done
		;;
	--enable|-e|enable)
		for t in "${TARGETS[@]}"; do
			if [[ -f "/etc/pam.d/${t}" ]]; then
				enable_file "$t"
			fi
		done
		;;
	--disable|-d|disable)
		for t in "${TARGETS[@]}"; do
			if [[ -f "/etc/pam.d/${t}" ]]; then
				disable_file "$t"
			fi
		done
		;;
	*)
		echo "Usage: $0 {--enable|--disable|--status} [sudo|login|all]"
		echo ""
		echo "Commands:"
		echo "  --status  [target]    Check if Touch ID is configured in target (default: sudo)"
		echo "  --enable  [target]    Enable complementary Touch ID with password fallback"
		echo "  --disable [target]    Remove Touch ID configuration from target"
		echo ""
		echo "Targets:"
		echo "  sudo    (default)     /etc/pam.d/sudo"
		echo "  login                 /etc/pam.d/login, /etc/pam.d/system-auth"
		echo "  all                   All detected login & auth services"
		exit 1
		;;
esac
